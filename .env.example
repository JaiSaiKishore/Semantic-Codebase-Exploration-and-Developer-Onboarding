# ==============================================================================
# Semantic Codebase RAG - Environment Variables Configuration
# Copy this file to .env and fill in your API keys:
# Windows (PowerShell): Copy-Item .env.example .env
# Linux / macOS:        cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq Cloud API Key (REQUIRED)
# Used by LangGraph agent for intent routing, LLM keyword expansion, and synthesis.
# Get a free, ultra-fast API key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. GitHub Personal Access Token (OPTIONAL)
# Increases GitHub API rate limit from 60 to 5,000 requests/hr for mining closed issues/PRs.
# If omitted or left blank, the system automatically falls back to unauthenticated public API.
# Generate a fine-grained or classic token at: https://github.com/settings/tokens
# ------------------------------------------------------------------------------
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 3. GitHub Webhook Secret (OPTIONAL)
# Used to verify HMAC SHA-256 signatures for CI/CD incremental AST updates (POST /webhook/github).
# ------------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=my_super_secret_webhook_key

# ------------------------------------------------------------------------------
# 4. Server URL (OPTIONAL)
# Used by test_webhook.py for webhook simulation.
# ------------------------------------------------------------------------------
SERVER_URL=http://localhost:8000

